/var/log/conntrackd-stats.log {
    maxsize 10M
    rotate 2
    missingok
    compress
    delaycompress

    postrotate
        if [ -e /var/run/conntrackd.sock ]; then
            /usr/sbin/invoke-rc.d conntrackd restart > /dev/null
        fi
    endscript
}

# conntrackd keeps this file open (General { LogFile on }), so truncate it in place instead of restarting the daemon
/var/log/conntrackd.log {
    maxsize 10M
    rotate 2
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
