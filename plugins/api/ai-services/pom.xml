<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <name>Apache CloudStack Plugin - AI Services</name>
    <artifactId>cloud-plugin-api-ai-services</artifactId>
    <parent>
        <artifactId>cloudstack-plugins</artifactId>
        <groupId>org.apache.cloudstack</groupId>
        <version>24.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!--
      Developed out of tree at https://github.com/kiwiflyer/CloudStack_AI_Plugin,
      where the pom is deliberately standalone so the module builds without a
      CloudStack checkout. This is that pom with the parent restored and the
      explicit versions dropped: cloud-api and the frameworks come from the
      reactor, and junit/mockito from the parent's dependencyManagement.
    -->
    <dependencies>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-utils</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-framework-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-framework-db</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-framework-events</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-engine-schema</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          The root pom manages mockito-core but not JUnit 5 — CloudStack's
          own tests are JUnit 4, and the one other Jupiter module declares
          its own version. These take the root's `cs.junit.jupiter.version`
          rather than a second opinion about which 5.x to use.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${cs.junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${cs.junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          mockito-core is not declared: the root pom puts it in its own
          <dependencies>, not in <dependencyManagement>, so every module
          inherits it already. Declaring it here is what fails, because
          there is no managed version to inherit.
        -->
    </dependencies>

    <build>
        <plugins>
            <!--
              Pinned with the JUnit Platform provider named explicitly.
              The root pom puts junit:junit 4.13.2 into every module's
              dependencies, so this module has JUnit 4 and 5 on one test
              classpath; surefire then has two providers to choose from
              and can pick JUnit 4, which runs none of these tests and
              reports success for having run nothing. That failure is
              silent, which is why it is spelled out rather than left
              to detection.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${cs.surefire-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>${cs.surefire-plugin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
